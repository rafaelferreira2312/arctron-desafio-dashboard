# Valores padrão para o ambiente Docker. Sobrescreva em .env.local (não versionado).

APP_ENV=dev
APP_SECRET=troque-este-valor-em-producao
APP_TIMEZONE=America/Sao_Paulo

DATABASE_URL="postgresql://app:app@database:5432/purchases?serverVersion=16&charset=utf8"

MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

# Mesmo secret configurado no webhook do WooCommerce
WOOCOMMERCE_WEBHOOK_SECRET=arctron-webhook-secret
